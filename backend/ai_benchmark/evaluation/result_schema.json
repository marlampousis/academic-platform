{
  "schema_version": "1.2",
  "required_fields": [
    "run_id",
    "timestamp",
    "provider",
    "model",
    "test_id",
    "case_id",
    "run_number",
    "input",
    "output",
    "execution",
    "evaluation",
    "batch_id",
    "requested_generation_options"
  ],
  "field_definitions": {
    "run_id": {
      "type": "string",
      "description": "Unique identifier for the benchmark run."
    },
    "timestamp": {
      "type": "string",
      "format": "ISO-8601",
      "description": "UTC timestamp indicating when the model call started."
    },
    "provider": {
      "type": "string",
      "allowed_values": [
        "ollama",
        "huggingface",
        "gemini",
        "mock"
      ]
    },
    "model": {
      "type": "string",
      "description": "Exact model identifier used for the benchmark run."
    },
    "test_id": {
      "type": "string",
      "description": "Benchmark test identifier."
    },
    "case_id": {
      "type": "string",
      "description": "Identifier of the benchmark case, such as candidate_a or candidate_a_gr."
    },
    "run_number": {
      "type": "integer",
      "minimum": 1,
      "description": "Repeated run number for the same test case."
    },
    "input": {
      "type": "object",
      "required_fields": [
        "prompt_file",
        "dataset_files",
        "expected_file",
        "rendered_prompt"
      ],
      "fields": {
        "prompt_file": {
          "type": "string"
        },
        "dataset_files": {
          "type": "array",
          "items": "string"
        },
        "expected_file": {
          "type": "string"
        },
        "rendered_prompt": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "required_fields": [
        "raw_response",
        "parsed_response",
        "json_validity",
        "parse_error"
      ],
      "fields": {
        "raw_response": {
          "type": "string"
        },
        "parsed_response": {
          "type": [
            "object",
            "array",
            "string",
            "null"
          ]
        },
        "json_validity": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "parse_error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "required_fields": [
        "latency_ms",
        "error",
        "error_message",
        "runtime_metadata"
      ],
      "fields": {
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "error": {
          "type": "boolean"
        },
        "error_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_metadata": {
          "type": "object",
          "description": "Provider runtime metadata. Mock may return an empty object; Ollama supplies every defined key, using null for unavailable measurements.",
          "fields": {
            "finish_reason": {
              "type": [
                "string",
                "null"
              ],
              "description": "Provider-reported completion reason; null if unavailable."
            },
            "output_truncated": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True for output token limit, false for a normal stop, null if unknown. Does not assess input truncation."
            },
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "load_duration_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "total_duration_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "requested_context_length": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Requested context tokens, not proof of effective allocation or complete input retention."
            },
            "thinking_enabled": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Requested thinking setting."
            },
            "timeout_seconds": {
              "type": [
                "number",
                "null"
              ],
              "exclusive_minimum": 0
            }
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "required_fields": [
        "automatic_metrics",
        "qualitative_metrics",
        "safety_metrics"
      ],
      "fields": {
        "automatic_metrics": {
          "type": "object"
        },
        "qualitative_metrics": {
          "type": "object"
        },
        "safety_metrics": {
          "type": "object"
        }
      }
    },
    "batch_id": {
      "type": "string",
      "format": "uuid",
      "description": "Shared identifier for one benchmark execution."
    },
    "requested_generation_options": {
      "type": "object",
      "required_fields": [
        "temperature",
        "max_output_tokens",
        "response_format"
      ],
      "fields": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "response_format": {
          "type": "string",
          "allowed_values": [
            "text",
            "json"
          ]
        }
      }
    }
  }
}
